diff --git a/AGENTS.md b/AGENTS.md
index 7f146f2..589686c 100644
--- a/AGENTS.md
+++ b/AGENTS.md
@@ -7,7 +7,9 @@ Build a small, native, offline iPhone prayer app. Read
 
 - Three sessions: morning, today's rosary, evening.
 - Ecclesiastical Latin first; paired English translation underneath.
-- Black background, white monospaced text, square controls, lowercase `daily`.
+- Black background, white EB Garamond text, square controls, lowercase `daily`.
+- Use `AppFont` for scalable typography. Bundle fonts and their OFL license.
+- Keep the approved monospaced app icon unchanged.
 - Listen, read silently, or both; one speed setting controls playback and
   automatic scrolling. Preserve pitch and resume position.
 - Bundle reviewed audio and text. No runtime AI, accounts, or backend.
diff --git a/Daily/App/AppFont.swift b/Daily/App/AppFont.swift
new file mode 100644
index 0000000..236a5d2
--- /dev/null
+++ b/Daily/App/AppFont.swift
@@ -0,0 +1,18 @@
+import SwiftUI
+
+enum AppFont {
+    static let largeTitle = Font.custom("EBGaramond-Bold", size: 38,
+                                       relativeTo: .largeTitle)
+    static let heading = Font.custom("EBGaramond-Bold", size: 28,
+                                    relativeTo: .title2)
+    static let title = Font.custom("EBGaramond-Regular", size: 26,
+                                  relativeTo: .title2)
+    static let primary = Font.custom("EBGaramond-Regular", size: 24,
+                                    relativeTo: .title3)
+    static let body = Font.custom("EBGaramond-Regular", size: 22,
+                                 relativeTo: .body)
+    static let secondary = Font.custom("EBGaramond-Regular", size: 19,
+                                      relativeTo: .subheadline)
+    static let caption = Font.custom("EBGaramond-Regular", size: 16,
+                                    relativeTo: .caption)
+}
