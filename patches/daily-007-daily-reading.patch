diff --git a/Daily/Content/DailyReadingPlan.swift b/Daily/Content/DailyReadingPlan.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d4dd022917b1164b594b3755f41b5ba79556e398
--- /dev/null
+++ b/Daily/Content/DailyReadingPlan.swift
@@ -0,0 +1,76 @@
+import Foundation
+
+struct DailyReadingPlan: Sendable {
+    struct Reading: Decodable, Equatable, Sendable {
+        let day: Int
+        let date: String
+        let ot: String
+        let nt: String
+        let ps: String
+        let prv: String
+        let notes: [String]?
+    }
+
+    enum Selection: Equatable, Sendable {
+        case reading(Reading)
+        case catchUp
+        case unavailable
+    }
+
+    enum LoadError: Error {
+        case missingResource
+        case invalidSchedule
+    }
+
+    private struct Document: Decodable {
+        let days: [Reading]
+    }
+
+    private let readings: [String: Reading]
+
+    init(data: Data) throws {
+        let days = try JSONDecoder().decode(Document.self, from: data).days
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(secondsFromGMT: 0)!
+        let start = calendar.date(from: DateComponents(year: 2001,
+                                                       month: 1, day: 1))!
+        guard days.count == 365 else { throw LoadError.invalidSchedule }
+        var indexed: [String: Reading] = [:]
+        for (index, reading) in days.enumerated() {
+            let date = calendar.date(byAdding: .day, value: index,
+                                     to: start)!
+            let expected = Self.dateKey(date, timeZone: calendar.timeZone)
+            guard reading.day == index + 1, reading.date == expected,
+                  [reading.ot, reading.nt, reading.ps, reading.prv]
+                    .allSatisfy({ !$0.trimmingCharacters(in: .whitespacesAndNewlines)
+                        .isEmpty }) else {
+                throw LoadError.invalidSchedule
+            }
+            indexed[reading.date] = reading
+        }
+        readings = indexed
+    }
+
+    static func load(bundle: Bundle = .main) throws -> DailyReadingPlan {
+        guard let url = bundle.url(forResource: "daily-reading-plan",
+                                   withExtension: "json") else {
+            throw LoadError.missingResource
+        }
+        return try DailyReadingPlan(data: Data(contentsOf: url))
+    }
+
+    func selection(on date: Date, timeZone: TimeZone = .current) -> Selection {
+        let key = Self.dateKey(date, timeZone: timeZone)
+        if key == "02-29" { return .catchUp }
+        guard let reading = readings[key] else { return .unavailable }
+        return .reading(reading)
+    }
+
+    private static func dateKey(_ date: Date, timeZone: TimeZone) -> String {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = timeZone
+        let month = calendar.component(.month, from: date)
+        let day = calendar.component(.day, from: date)
+        return "\(month < 10 ? "0" : "")\(month)-\(day < 10 ? "0" : "")\(day)"
+    }
+}
diff --git a/Daily/Features/Home/DailyReadingView.swift b/Daily/Features/Home/DailyReadingView.swift
new file mode 100644
index 0000000000000000000000000000000000000000..734803252918f167f24ae7e46aab315ae220356f
--- /dev/null
+++ b/Daily/Features/Home/DailyReadingView.swift
@@ -0,0 +1,93 @@
+import SwiftUI
+import UIKit
+
+struct DailyReadingView: View {
+    @Environment(\.scenePhase) private var scenePhase
+    @ScaledMetric(relativeTo: .title2) private var sectionGap = 26
+    @State private var plan: DailyReadingPlan?
+    @State private var date = Date()
+    @State private var loadFailed = false
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 24) {
+            Text("daily reading")
+                .font(AppFont.largeTitle)
+                .frame(maxWidth: .infinity, alignment: .center)
+                .accessibilityAddTraits(.isHeader)
+            if let plan {
+                switch plan.selection(on: date) {
+                case .reading(let reading):
+                    Grid(alignment: .leading, horizontalSpacing: 12,
+                         verticalSpacing: 12) {
+                        row("OT", name: "Old Testament and Apocrypha",
+                            reference: reading.ot)
+                        row("NT", name: "New Testament", reference: reading.nt)
+                        row("Ps", name: "Psalms", reference: reading.ps)
+                        row("Prv", name: "Proverbs", reference: reading.prv)
+                    }
+                    if let notes = reading.notes {
+                        ForEach(notes, id: \.self) { note in
+                            Text(note)
+                                .font(AppFont.secondary)
+                                .fixedSize(horizontal: false, vertical: true)
+                        }
+                    }
+                case .catchUp:
+                    Text("catch up and reflect\nnew readings resume tomorrow")
+                        .font(AppFont.body)
+                case .unavailable:
+                    unavailable
+                }
+            } else if loadFailed {
+                unavailable
+            } else {
+                Text("loading readings…")
+                    .font(AppFont.body)
+            }
+        }
+        .font(AppFont.title)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .padding(.top, sectionGap)
+        .task {
+            do {
+                let loaded = try await Task.detached(priority: .userInitiated) {
+                    try DailyReadingPlan.load()
+                }.value
+                guard !Task.isCancelled else { return }
+                plan = loaded
+                date = Date()
+            } catch {
+                loadFailed = true
+            }
+        }
+        .onChange(of: scenePhase) { _, phase in
+            if phase == .active { date = Date() }
+        }
+        .onReceive(NotificationCenter.default.publisher(
+            for: UIApplication.significantTimeChangeNotification
+        )) { _ in date = Date() }
+        .onReceive(NotificationCenter.default.publisher(
+            for: NSNotification.Name.NSSystemTimeZoneDidChange
+        )) { _ in date = Date() }
+    }
+
+    private var unavailable: some View {
+        Text("readings unavailable")
+            .font(AppFont.body)
+    }
+
+    private func row(_ label: String, name: String,
+                     reference: String) -> some View {
+        GridRow(alignment: .firstTextBaseline) {
+            Text("\(label):")
+                .fixedSize()
+                .gridColumnAlignment(.leading)
+            Text(reference)
+                .frame(maxWidth: .infinity, alignment: .leading)
+                .fixedSize(horizontal: false, vertical: true)
+                .layoutPriority(1)
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("\(name): \(reference)")
+    }
+}
